{
  "expo": {
    "name": "Smart Service",
    "slug": "smart-service",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "android": {
      "package": "bd.upservice.app",
      "permissions": [
        "CAMERA",
        "RECORD_AUDIO",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE"
      ]
    },
    "ios": {
      "bundleIdentifier": "bd.upservice.app",
      "infoPlist": {
        "NSCameraUsageDescription": "This app uses the camera to scan QR codes and take photos.",
        "NSMicrophoneUsageDescription": "This app uses the microphone for video recording."
      }
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "kotlinVersion": "2.1.0"
          }
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "334facdf-ec0d-42f7-8aff-82cc8e122b1d"
      }
    }
  }
}
